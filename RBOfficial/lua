)

-- Delay Text
local delayLabel = Instance.new("TextLabel")
delayLabel.Size = UDim2.new(0.84, 0, 0, 40)
delayLabel.Position = UDim2.new(0.08, 0, 0, 370)
delayLabel.BackgroundTransparency = 1
delayLabel.Text = "Delay: 10s"
delayLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
delayLabel.TextScaled = true
delayLabel.Font = Enum.Font.GothamBold
delayLabel.Parent = main

-- Button state
local ready = false

forceAccept.Active = false
freezeVictim.Active = false

--// 10 SECOND COUNTDOWN //--

task.spawn(function()

	for seconds = 10, 0, -1 do

		delayLabel.Text = "Delay: " .. seconds .. "s"

		task.wait(1)

	end

	ready = true

	forceAccept.Active = true
	freezeVictim.Active = true

	delayLabel.Text = "Ready!"

end)

--// FORCE ACCEPT VISUAL //--

forceAccept.MouseButton1Click:Connect(function()

	if not ready then
		return
	end

	forceAccept.Text = "ACCEPTED ✓"

	task.delay(1.5, function()

		if forceAccept then
			forceAccept.Text = "Force Accept"
		end

	end)

end)

--// FREEZE VICTIM VISUAL //--

freezeVictim.MouseButton1Click:Connect(function()

	if not ready then
		return
	end

	freezeVictim.Text = "FROZEN ✓"

	task.delay(1.5, function()

		if freezeVictim then
			freezeVictim.Text = "Freeze Victim"
		end

	end)

end)

--// MOVABLE WINDOW //--

local dragging = false
local dragStart
local startPosition

main.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true

		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end

		end)

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)

	end

end)
